{
  "name": "food-roguelike",
  "version": "1.0.0",
  "description": "A food-themed roguelike game with cooking mechanics",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && vite build",
    "build:gh": "GITHUB_PAGES=true npm run build",
    "dev": "vite",
    "preview": "vite preview",
    "preview:gh": "GITHUB_PAGES=true npm run build && vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "roguelike",
    "game",
    "typescript",
    "svg"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@vitest/ui": "^4.0.8",
    "typescript": "^5.3.3",
    "vite": "^5.0.0",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "preact": "^10.27.2"
  }
}
